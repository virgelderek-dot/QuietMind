# Copy to .env. Every value is optional — the app runs with none of them set.

# Port for the API + UI server.
PORT=3100

# IANA timezone that decides when "today" rolls over.
# Set this to your own zone so the digest turns over at your midnight, not UTC's.
SVAI_TIMEZONE=America/New_York

# Optional. When set, the top stories get a "why it matters" note and suggested
# actions written by Claude for that specific story instead of the built-in
# category-based ones. Without it the digest still works — the notes are just
# more generic.
# ANTHROPIC_API_KEY=sk-ant-...

# Effort level for the enrichment pass: low | medium | high | xhigh | max.
# Lower is cheaper and faster; this is routine summarisation, so medium is the
# default. Only used when ANTHROPIC_API_KEY is set.
SVAI_EFFORT=medium

# Where daily digests are written. Defaults to ./data/digests
# SVAI_DATA_DIR=/var/lib/singular-vision/digests
